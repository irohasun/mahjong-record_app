{
  "expo": {
    "name": "じゃんれき",
    "slug": "mahjong-record-app",
    "version": "1.1.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.name.MahjongRecord",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "麻雀の対局記録を撮影するために、カメラへのアクセスが必要です。撮影した写真は対局記録と一緒に保存され、後から対局の詳細を確認する際に表示されます。",
        "NSMicrophoneUsageDescription": "音声メモを録音するために、マイクへのアクセスが必要です。録音した音声は対局記録のメモとして保存されます。",
        "NSPhotoLibraryUsageDescription": "対局記録の写真を保存・選択するために、フォトライブラリへのアクセスが必要です。例えば、対局終了時の点棒状況や牌譜の写真を選択して記録に添付できます。",
        "NSPhotoLibraryAddUsageDescription": "撮影した対局記録の写真をフォトライブラリに保存するために、アクセスが必要です。保存した写真は後から対局の振り返りに使用できます。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mahjongrecord.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "useAndroidX": true,
            "enableJetifier": true
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "./plugins/withAndroidManifestFix.js",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF6B35",
          "sounds": [
            "./assets/sounds/notification.wav"
          ]
        }
      ]
    ],
    "notification": {
      "icon": "./assets/images/notification-icon.png",
      "color": "#FF6B35",
      "iosDisplayInForeground": true,
      "androidMode": "default",
      "androidCollapsedTitle": "新しい通知"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38ea6434-be87-4148-84df-c73cfda620f2"
      }
    },
    "owner": "koyake"
  }
}